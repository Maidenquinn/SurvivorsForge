	email {$ACME_EMAIL}
}

{$DOMAIN_WEB} {
	# Uploaded images straight from the volume; nothing outside /img/ is ever served from it.
	handle_path /img/* {
		root * /srv/img
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}
	# Built addon packs; the name is the SHA-256 of the pack's versions, so the file never changes.
	handle_path /packs-files/* {
		root * /srv/packs
		header Cache-Control "public, max-age=86400"
		header X-Content-Type-Options nosniff
		header Content-Disposition "attachment; filename=\"SurvivorsForge-pack.zip\""
		file_server
	}
	handle {
		reverse_proxy web:8080
	}
}

{$DOMAIN_API} {
	reverse_proxy api:8080
}
