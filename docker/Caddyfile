	email {$ACME_EMAIL}
}

{$DOMAIN_WEB} {
	# Uploaded images straight from the volume; nothing outside /img/ is ever served from it.
	handle_path /img/* {
		root * /srv/img
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options nosniff
		file_server
	}
	handle {
		reverse_proxy web:8080
	}
}

{$DOMAIN_API} {
	reverse_proxy api:8080
}
