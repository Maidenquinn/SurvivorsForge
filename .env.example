# SurvivorsForge platform configuration. Copy to `.env` and fill in.
# `.env` is git-ignored; never commit real values.

# --- forge-api ---
# Postgres connection string.
DATABASE_URL=postgres://forge:change-me@postgres:5432/forge
# Public base URL of the API, without trailing slash.
PUBLIC_API_URL=https://api.forge.example.com
# Address the API listens on inside the container.
BIND_ADDR=0.0.0.0:8080
# Apply database migrations when `forge-api serve` starts.
MIGRATE_ON_START=true
# Requests per minute and client IP.
RATE_LIMIT_PER_MINUTE=120
# Comma-separated IPs of reverse proxies whose X-Forwarded-For header is trusted.
TRUSTED_PROXIES=
