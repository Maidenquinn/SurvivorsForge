# SurvivorsForge platform configuration. Copy to `.env` and fill in.
# `.env` is git-ignored; never commit real values.

# --- forge-api ---
# Postgres connection string.
DATABASE_URL=postgres://forge:change-me@postgres:5432/forge
# Public base URL of the API, without trailing slash.
PUBLIC_API_URL=https://api.forge.example.com
# Address the API listens on inside the container.
BIND_ADDR=0.0.0.0:8080
# Apply database migrations when `forge-api serve` starts.
MIGRATE_ON_START=true
# Requests per minute and client IP.
RATE_LIMIT_PER_MINUTE=120
# Folder the API stores uploaded images in (a volume the reverse proxy serves read-only).
IMAGE_DIR=/data/images
# Public base URL of uploaded images (served by the reverse proxy), without trailing slash.
PUBLIC_IMAGE_URL=https://forge.example.com/img
# How many versions the 6-hourly source check compares with GitHub per run.
SOURCE_CHECK_BATCH=200
# Comma-separated IPs of reverse proxies whose X-Forwarded-For header is trusted.
TRUSTED_PROXIES=

# --- GitHub App (see docs/self-hosting.md) ---
# GitHub REST API base URL.
GITHUB_API_URL=https://api.github.com
# Numeric App ID from the App's settings page.
GITHUB_APP_ID=123456
# The App's private key: either the PEM text (newlines as \n) ...
GITHUB_APP_PRIVATE_KEY=
# ... or a path to the .pem file inside the container.
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Secret entered in the App's webhook settings.
GITHUB_WEBHOOK_SECRET=change-me
# Base URL for GitHub's OAuth pages.
GITHUB_OAUTH_URL=https://github.com
# Client ID and client secret of the GitHub App (for user logins).
GITHUB_CLIENT_ID=Iv1.0000000000000000
GITHUB_CLIENT_SECRET=change-me

# --- Login and roles ---
# Comma-separated, exact client callback URLs a login may return to (the website's /auth/callback).
AUTH_RETURN_URLS=https://forge.example.com/auth/callback
# Comma-separated numeric GitHub user IDs that are admins (https://api.github.com/users/<login> -> id).
ADMIN_GITHUB_IDS=

# --- forge-web ---
# Where the website reaches the API inside the Compose network.
API_INTERNAL_URL=http://api:8080
# Public base URL of the website, without trailing slash.
PUBLIC_WEB_URL=https://forge.example.com
# At least 32 random characters; encrypts the session cookies (e.g. `openssl rand -hex 32`).
COOKIE_KEY=change-me-to-64-random-hex-characters-change-me-change-me-0000
# URL name of the GitHub App (github.com/apps/<slug>), for the "install the App" link.
GITHUB_APP_SLUG=survivorsforge
# Address the website listens on inside its container.
WEB_BIND_ADDR=0.0.0.0:8080
