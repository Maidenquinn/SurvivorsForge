import { Theme } from "theme.slint";
import {
    AddonRow, ActionButton, TabButton, SectionHeading, Field, ScrollPanel, AddonRowView,
    Overlay, Panel, DialogCard, TitleBar, ResizeEdges
} from "components.slint";

export { AddonRow, Theme }

// An AddOns folder found on this machine: short label for the button, full path to use.
export struct Suggestion {
    label: string,
    path: string,
}

// Shown under a path field when there is no file dialog to browse with.
component TypePathHint inherits Text {
    in property <bool> game-mode;
    text: "Type the full path to the AddOns folder." + (root.game-mode ? " Press STEAM + X for the on-screen keyboard." : "");
    font-size: Theme.meta;
    color: Theme.text-muted;
    wrap: word-wrap;
}

component SetupView inherits Rectangle {
    in-out property <string> path;
    in property <string> error;
    in property <string> warning;
    in property <string> example;
    in property <bool> file-dialog;
    in property <bool> game-mode;
    // AddOns folders found on this machine, offered for one click.
    in property <[Suggestion]> suggestions;
    in property <bool> searching;
    callback browse();
    callback confirm();
    callback pick(string);
    callback quit();

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Panel {
                width: 600px;
                VerticalLayout {
                    padding: 32px;
                    spacing: 18px;
                    Text {
                        text: "SurvivorsForge";
                        font-family: Theme.font-display;
                        font-size: Theme.logo;
                        color: Theme.gold-heading;
                        horizontal-alignment: center;
                    }
                    SectionHeading {
                        text: "AddOns folder";
                        size: 22px;
                    }
                    Text {
                        text: "Select the AddOns folder of Azeroth Survivors. It sits next to the game's executable, for example " + root.example + ".";
                        font-size: Theme.body;
                        color: Theme.text;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.gap-tight;
                        Field {
                            text <=> root.path;
                            placeholder: "AddOns folder";
                            accepted => { root.confirm(); }
                        }
                        if root.file-dialog : ActionButton {
                            text: "Browse...";
                            clicked => { root.browse(); }
                        }
                    }
                    if !root.file-dialog : TypePathHint {
                        game-mode: root.game-mode;
                    }
                    if root.error != "" : Text {
                        text: "Error: " + root.error;
                        font-size: Theme.body;
                        color: Theme.danger;
                        wrap: word-wrap;
                    }
                    if root.warning != "" : Text {
                        text: root.warning;
                        font-size: Theme.body;
                        color: Theme.warn;
                        wrap: word-wrap;
                    }
                    // One row tall from the start, so the list arriving doesn't move Continue much.
                    VerticalLayout {
                        spacing: 6px;
                        min-height: 34px;
                        if root.searching : Text {
                            text: "Searching this computer for the AddOns folder...";
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                        }
                        if !root.searching && root.suggestions.length == 0 : Text {
                            text: "No AddOns folder found automatically. If the game never ran yet, start it once so it creates the folder. Then "
                                + (root.file-dialog ? "use Browse or type the path." : "type the path.");
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                            wrap: word-wrap;
                        }
                        if root.suggestions.length > 0 : Text {
                            text: "Found on this computer. Select one to use it:";
                            font-size: Theme.meta;
                            color: Theme.text-muted;
                        }
                        for suggestion in root.suggestions : ActionButton {
                            text: "Use " + suggestion.label;
                            min-width: 0;
                            clicked => { root.pick(suggestion.path); }
                        }
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: Theme.gap-tight;
                        if root.game-mode : ActionButton {
                            text: "Quit";
                            large: true;
                            clicked => { root.quit(); }
                        }
                        ActionButton {
                            text: root.warning != "" ? "Use This Folder Anyway" : "Continue";
                            primary: true;
                            large: true;
                            enabled: root.path != "";
                            clicked => { root.confirm(); }
                        }
                    }
                }
            }
        }
    }
}

component SettingRow inherits HorizontalLayout {
    in property <string> label;
    spacing: Theme.gap-loose;
    Text {
        width: 180px;
        text: root.label;
        font-size: 16px;
        color: Theme.gold;
        vertical-alignment: center;
    }
    @children
}

component SettingsView inherits VerticalLayout {
    in-out property <string> path;
    in property <string> message;
    in property <bool> message-error;
    in property <string> version;
    in property <bool> file-dialog;
    in property <bool> game-mode;
    callback browse();
    callback save();

    spacing: 16px;
    alignment: start;

    SettingRow {
        label: "AddOns folder";
        Field {
            text <=> root.path;
            accepted => { root.save(); }
        }
        if root.file-dialog : ActionButton {
            text: "Browse...";
            clicked => { root.browse(); }
        }
    }
    if !root.file-dialog : HorizontalLayout {
        padding-left: 180px + Theme.gap-loose;
        TypePathHint {
            game-mode: root.game-mode;
        }
    }
    SettingRow {
        label: "Version";
        Text {
            text: "SurvivorsForge " + root.version;
            font-size: Theme.body;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    HorizontalLayout {
        spacing: 16px;
        alignment: end;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: (root.message-error ? "Error: " : "") + root.message;
                font-size: Theme.body;
                color: root.message-error ? Theme.danger : Theme.ok;
                horizontal-alignment: right;
                wrap: word-wrap;
            }
        }
        ActionButton {
            text: "Save";
            primary: true;
            clicked => { root.save(); }
        }
    }
}

export component AppWindow inherits Window {
    title: "SurvivorsForge";
    icon: @image-url("../assets/icon.png");
    no-frame: true;
    min-width: 980px;
    min-height: 660px;
    preferred-width: 1180px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-family: Theme.font-body;

    in property <string> app-version;
    in property <string> addons-example;

    // Own window frame
    callback start-drag();
    callback start-resize(int);
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // Steam Deck Game Mode / gamescope: fullscreen without window frame.
    in property <bool> game-mode;
    property <length> title-height: root.game-mode ? 0px : 34px;
    // False without a usable file dialog (no portal, or Game Mode): Browse and Install zip hide.
    in property <bool> file-dialog: true;

    // First start
    in property <bool> needs-setup;
    in-out property <string> setup-path;
    in property <string> setup-error;
    in property <string> setup-warning;
    in property <[Suggestion]> setup-suggestions;
    in property <bool> setup-searching: true;
    callback setup-browse();
    callback setup-confirm();

    // 0 installed, 1 browse, 2 settings
    in-out property <int> page: 0;
    in property <[AddonRow]> installed-rows;
    in property <[AddonRow]> browse-rows;
    in property <int> installed-total;
    in-out property <string> search;
    callback search-changed(string);
    in property <string> addons-dir;
    in property <int> update-count;
    in property <bool> checking;
    callback check-updates();
    callback update-all();
    callback install-zip();
    callback add-repo();
    callback row-action(string);
    callback row-remove(string);
    callback row-open(string);

    in property <string> status-text;
    in property <bool> status-error;

    // Settings
    in-out property <string> settings-path;
    in property <string> settings-message;
    in property <bool> settings-message-error;
    callback settings-browse();
    callback settings-save();

    // Confirmation dialog
    in property <bool> confirm-open;
    in property <string> confirm-title;
    in property <string> confirm-text;
    in property <string> confirm-ok;
    in property <bool> confirm-danger;
    callback confirm-accept();
    callback confirm-cancel();

    // Add-repo dialog
    in-out property <bool> repo-open;
    in-out property <string> repo-input;
    in property <string> repo-error;
    in property <bool> repo-busy;
    callback repo-submit();
    callback repo-cancel();

    // Self-update banner, empty version = hidden
    in property <string> self-update-version;
    in property <bool> self-update-busy;
    // False for a bare Linux binary outside an AppImage: it can't replace itself.
    in property <bool> self-update-in-place: true;
    callback self-update();

    Rectangle {
        background: Theme.bg-glow;
    }

    if root.needs-setup : SetupView {
        y: root.title-height;
        width: parent.width;
        height: parent.height - root.title-height;
        path <=> root.setup-path;
        error: root.setup-error;
        warning: root.setup-warning;
        example: root.addons-example;
        suggestions: root.setup-suggestions;
        searching: root.setup-searching;
        file-dialog: root.file-dialog;
        game-mode: root.game-mode;
        browse => { root.setup-browse(); }
        pick(path) => { root.setup-path = path; root.setup-confirm(); }
        confirm => { root.setup-confirm(); }
        quit => { root.close-window(); }
    }

    if !root.needs-setup : VerticalLayout {
        y: root.title-height;
        width: parent.width;
        height: parent.height - root.title-height;
        padding-left: 28px;
        padding-right: 28px;
        padding-bottom: 8px;
        spacing: 14px;

        Text {
            text: "SurvivorsForge";
            font-family: Theme.font-display;
            font-size: Theme.logo;
            color: Theme.gold-heading;
            horizontal-alignment: center;
        }

        HorizontalLayout {
            alignment: center;
            spacing: 10px;
            TabButton {
                text: "Installed (" + root.installed-total + ")";
                active: root.page == 0;
                clicked => { root.page = 0; }
            }
            TabButton {
                text: "Browse";
                active: root.page == 1;
                clicked => { root.page = 1; }
            }
            TabButton {
                text: "Settings";
                active: root.page == 2;
                clicked => { root.page = 2; }
            }
            // Game Mode has no title bar, so give it its own way out.
            if root.game-mode : TabButton {
                text: "Quit";
                clicked => { root.close-window(); }
            }
        }

        if root.self-update-version != "" : Rectangle {
            height: 48px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.outline-hover;
            background: Theme.crimson;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 8px;
                spacing: 16px;
                Text {
                    text: "SurvivorsForge " + root.self-update-version + " is available.";
                    font-size: Theme.body;
                    color: Theme.gold-bright;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    ActionButton {
                        text: root.self-update-busy ? "Updating..." : root.self-update-in-place ? "Update and restart" : "Open download page";
                        enabled: !root.self-update-busy;
                        clicked => { root.self-update(); }
                    }
                }
            }
        }

        Panel {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                SectionHeading {
                    text: root.page == 0 ? "Installed" : root.page == 1 ? "Verified Addons" : "Settings";
                }

                if root.page != 2 : HorizontalLayout {
                    spacing: Theme.gap-tight;
                    Field {
                        width: 280px;
                        placeholder: "Search name or author";
                        text <=> root.search;
                        edited(text) => { root.search-changed(text); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if root.page == 0 : ActionButton {
                        text: root.checking ? "Checking..." : "Check for updates";
                        enabled: !root.checking;
                        clicked => { root.check-updates(); }
                    }
                    if root.page == 0 && root.file-dialog : ActionButton {
                        text: "Install zip";
                        clicked => { root.install-zip(); }
                    }
                    if root.page == 0 : ActionButton {
                        text: "Add repo";
                        clicked => { root.add-repo(); }
                    }
                    if root.page == 0 : ActionButton {
                        text: root.update-count > 0 ? "Update all (" + root.update-count + ")" : "All up to date";
                        primary: root.update-count > 0;
                        enabled: root.update-count > 0;
                        clicked => { root.update-all(); }
                    }
                }

                if root.page == 0 : ScrollPanel {
                    vertical-stretch: 1;
                    for row in root.installed-rows : AddonRowView {
                        addon: row;
                        action => { root.row-action(row.id); }
                        remove => { root.row-remove(row.id); }
                        open => { root.row-open(row.id); }
                    }
                    if root.installed-rows.length == 0 : Text {
                        text: root.search != "" ? "No installed addon matches your search." : "No addons installed yet. Browse the verified addons, install a zip or add a GitHub repo.";
                        font-size: Theme.body;
                        color: Theme.text-muted;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                    }
                }

                if root.page == 1 : ScrollPanel {
                    vertical-stretch: 1;
                    for row in root.browse-rows : AddonRowView {
                        addon: row;
                        action => { root.row-action(row.id); }
                        open => { root.row-open(row.id); }
                    }
                    if root.browse-rows.length == 0 : Text {
                        text: "No verified addon matches your search.";
                        font-size: Theme.body;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                    }
                }

                if root.page == 2 : SettingsView {
                    vertical-stretch: 1;
                    path <=> root.settings-path;
                    message: root.settings-message;
                    message-error: root.settings-message-error;
                    version: root.app-version;
                    file-dialog: root.file-dialog;
                    game-mode: root.game-mode;
                    browse => { root.settings-browse(); }
                    save => { root.settings-save(); }
                }
            }
        }

        HorizontalLayout {
            height: 20px;
            spacing: 16px;
            Text {
                text: root.status-text != "" ? root.status-text : "AddOns: " + root.addons-dir;
                font-size: Theme.meta;
                vertical-alignment: center;
                color: root.status-error ? Theme.danger : Theme.text-muted;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Text {
                text: "v" + root.app-version;
                font-size: 11px;
                vertical-alignment: center;
                color: Theme.text-muted;
            }
        }
    }

    if root.repo-open : Overlay {
        y: root.title-height;
        width: parent.width;
        height: parent.height - root.title-height;
        DialogCard {
            title: "Add GitHub Repo";
            Text {
                text: "SurvivorsForge checks the latest release, then the newest tag, then the default branch for an addon.";
                font-size: Theme.body;
                color: Theme.text;
                wrap: word-wrap;
            }
            Field {
                text <=> root.repo-input;
                placeholder: "owner/repo or https://github.com/owner/repo";
                enabled: !root.repo-busy;
                init => { self.focus-input(); }
                accepted => { root.repo-submit(); }
            }
            if root.repo-error != "" : Text {
                text: root.repo-error;
                font-size: Theme.body;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.gap-tight;
                ActionButton {
                    text: "Cancel";
                    enabled: !root.repo-busy;
                    clicked => { root.repo-cancel(); }
                }
                ActionButton {
                    text: root.repo-busy ? "Checking..." : "Check repo";
                    primary: true;
                    enabled: !root.repo-busy && root.repo-input != "";
                    clicked => { root.repo-submit(); }
                }
            }
        }
    }

    if root.confirm-open : Overlay {
        y: root.title-height;
        width: parent.width;
        height: parent.height - root.title-height;
        DialogCard {
            title: root.confirm-title;
            Text {
                text: root.confirm-text;
                font-size: Theme.body;
                color: Theme.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Theme.gap-tight;
                ActionButton {
                    text: "Cancel";
                    clicked => { root.confirm-cancel(); }
                }
                ActionButton {
                    text: root.confirm-ok;
                    primary: !root.confirm-danger;
                    danger: root.confirm-danger;
                    clicked => { root.confirm-accept(); }
                }
            }
        }
    }

    if !root.game-mode : TitleBar {
        x: 0;
        y: 0;
        width: parent.width;
        title: root.title;
        maximized: root.maximized;
        start-drag => { root.start-drag(); }
        minimize => { root.minimize(); }
        toggle-maximize => { root.toggle-maximize(); }
        close => { root.close-window(); }
    }

    if !root.maximized && !root.game-mode : ResizeEdges {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        start-resize(direction) => { root.start-resize(direction); }
    }
}
