// Warm dark neutrals with WoW gold as the one signature colour.
// Gold marks only the primary action and "update available".
// Surfaces separate by flat colour steps; no borders, no shadows.
export global Theme {
    out property <color> bg: #16130F;
    out property <color> surface-1: #1F1A14;
    out property <color> surface-2: #2A241C;
    out property <color> surface-3: #362E24;
    out property <color> overlay: #000000B0;

    out property <color> text: #EDE6DA;
    out property <color> text-muted: #9C9284;

    out property <color> accent: #E8A33D;
    out property <color> accent-hover: #F2B65A;
    out property <color> on-accent: #1A1510;

    out property <color> ok: #6FBF73;
    out property <color> danger: #E5604F;

    out property <length> title: 26px;
    out property <length> heading: 16px;
    out property <length> body: 13px;
    out property <length> meta: 11px;

    out property <length> gap-tight: 8px;
    out property <length> gap-loose: 24px;
    out property <length> radius: 6px;
}
